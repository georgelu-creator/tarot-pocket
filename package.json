{
  "name": "tarot-pocket",
  "version": "1.7.3",
  "private": true,
  "description": "Offline tarot learning through images, recall, and contextual readings. English and Chinese.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "python3 tools/build_demo.py",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1",
    "test": "node tools/run_checks.cjs",
    "test:locales": "node tools/check_locales.cjs",
    "test:assets": "python3 tools/verify_assets.py",
    "serve:ai": "node --env-file=server/.env server/reading-service.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
