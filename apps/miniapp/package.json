{
  "name": "tarot-pocket-cross-platform",
  "version": "0.4.0",
  "scripts": {
    "prepare:content": "node tools/prepare-content.cjs",
    "dev:h5": "npm run build:h5 && node tools/preview.cjs",
    "dev:mp-weixin": "npm run prepare:content && uni -p mp-weixin",
    "build:h5": "npm run prepare:content && uni build",
    "build:mp-weixin": "npm run prepare:content && uni build -p mp-weixin && node tools/check-package.cjs",
    "type-check": "vue-tsc --noEmit",
    "test": "node tools/check-core.cjs && node tools/check-drawing.cjs",
    "test:ui": "npm run build:h5 && node ../../tools/check-learning-page.cjs && node ../../tools/check_mengyu_learning.cjs && node ../../tools/check-miniapp-ui.cjs && node ../../tools/check_miniapp_reference_depth.cjs && node tools/check-preview.cjs",
    "preview:h5": "node tools/preview.cjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vue/tsconfig": "^0.1.3",
    "@vue/runtime-core": "^3.4.21",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  },
  "private": true
}
